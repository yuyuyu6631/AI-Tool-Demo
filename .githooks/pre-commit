#!/bin/sh

# ── Step 1: lint-staged (lint + format staged files) ──
npx lint-staged
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  echo "lint-staged failed — commit aborted"
  exit "$STATUS"
fi

# ── Step 2: code tree hygiene ──
npm run tree:check
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  echo "code tree check failed — commit aborted"
  exit "$STATUS"
fi

# ── Step 3: auto-sync implementation baseline docs ──
node scripts/sync_current_docs.js >/dev/null
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  echo "docs sync failed"
  exit "$STATUS"
fi

git add docs/current-implementation-baseline.md docs/current-implementation-baseline.json
